# Sin nada configurado funciona el modo demo (datos ficticios, panel abierto).

# Clave del panel del autónomo (16 caracteres o más). Con ella, el panel y la API exigen la
# cabecera x-presupuestin-token. Obligatoria en cuanto haya clientes reales.
PRESUPUESTIN_TOKEN=

# URL pública para los enlaces que recibe el cliente (p. ej. https://presupuestin.vercel.app).
# Si no se configura, se usa el origen de la petición.
PRESUPUESTIN_URL_PUBLICA=
